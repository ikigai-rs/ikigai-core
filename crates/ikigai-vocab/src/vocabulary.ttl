@prefix ik:   <https://ikigai-rs.dev/ns#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# The ikigai self-description vocabulary. Endpoints project their structured
# Description to RDF using these terms; the kernel's catalog is a graph of them.
# Hand-maintained; bundled into ikigai-vocab via include_str! and served at
# urn:ikigai:vocab (and, externally, at this namespace URL).

<https://ikigai-rs.dev/ns#> a owl:Ontology ;
    rdfs:label "ikigai endpoint vocabulary" ;
    rdfs:comment "Self-description vocabulary for ikigai resource-oriented endpoints." .

#
# Classes
#

ik:Endpoint a rdfs:Class ;
    rdfs:label "Endpoint" ;
    rdfs:comment "A resolvable resource-oriented endpoint." .

ik:Transreptor a rdfs:Class ;
    rdfs:subClassOf ik:Endpoint ;
    rdfs:label "Transreptor" ;
    rdfs:comment "An endpoint that converts a representation from one media type to another (a transreption)." .

#
# Properties
#

ik:id a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range xsd:string ;
    rdfs:label "id" ;
    rdfs:comment "The endpoint's resource identifier." .

ik:title a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range xsd:string ;
    rdfs:label "title" ;
    rdfs:comment "A short human title for the endpoint." .

ik:Action a rdfs:Class ;
    rdfs:label "Action" ;
    rdfs:comment "One verb's contract on an endpoint — the (endpoint, verb) pair is the unit of selection. Carries its own ik:verb, ik:input set, ik:output set, and ik:requires capability scopes. Normalized from the endpoint description: single-verb endpoints' flat declarations synthesize one, per-verb declarations author them explicitly." .

ik:action a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range ik:Action ;
    rdfs:label "action" ;
    rdfs:comment "Links an endpoint to one of its per-verb contracts." .

ik:summary a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range xsd:string ;
    rdfs:label "summary" ;
    rdfs:comment "A longer human description of the endpoint." .

ik:verb a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range xsd:string ;
    rdfs:label "verb" ;
    rdfs:comment "A verb the endpoint answers: Source, Sink, Exists, Delete, or Meta." .

ik:output a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:range xsd:string ;
    rdfs:label "output" ;
    rdfs:comment "A media type the endpoint can produce." .

ik:input a rdf:Property ;
    rdfs:domain ik:Endpoint ;
    rdfs:label "input" ;
    rdfs:comment "A named input the endpoint (or one of its ik:Action nodes) accepts; the value node carries ik:inputName, ik:source, ik:required, and optionally ik:summary, ik:class, ik:default, and ik:oneOf." .

ik:inputName a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "inputName" ;
    rdfs:comment "The name of an input parameter." .

ik:source a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "source" ;
    rdfs:comment "How an input arrives: \"argument\" (by value) or \"binding\" (captured from the resource identifier)." .

ik:required a rdf:Property ;
    rdfs:range xsd:boolean ;
    rdfs:label "required" ;
    rdfs:comment "Whether an input is required." .

ik:transreptsFrom a rdf:Property ;
    rdfs:domain ik:Transreptor ;
    rdfs:range xsd:string ;
    rdfs:label "transreptsFrom" ;
    rdfs:comment "A media type this transreptor can read (convert from)." .

ik:transreptsTo a rdf:Property ;
    rdfs:domain ik:Transreptor ;
    rdfs:range xsd:string ;
    rdfs:label "transreptsTo" ;
    rdfs:comment "A media type this transreptor can produce (convert to)." .

ik:class a rdf:Property ;
    rdfs:label "class" ;
    rdfs:comment "The RDF class or XSD datatype an input's value is expected to be (an IRI), on an input node — rdfs:Class for entity-valued inputs, xsd datatype for scalars. Drives type-based action selection: an endpoint whose required inputs' classes are present can be offered for those entities." .

ik:default a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "default" ;
    rdfs:comment "The value an input assumes when omitted." .

ik:oneOf a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "oneOf" ;
    rdfs:comment "One accepted value of an enumerated input (repeated per value); absent = open-valued." .

ik:requires a rdf:Property ;
    rdfs:label "requires" ;
    rdfs:comment "A capability scope invoking the endpoint (or one of its ik:Action nodes) requires — a capability IRI such as urn:cap:personal:calendar:write, or a legacy descriptive label. Descriptive, not a runtime capability; selection uses it to project a capability-scoped catalog (an agent only sees actions its capability satisfies), and enforcement at invoke time is the authority." .

# ---- events (the calendar/agenda event graph) --------------------------------
# Events themselves are typed with the iCalendar vocabulary
# (http://www.w3.org/2002/12/cal/ical# — ical:Vevent, ical:uid, ical:summary,
# ical:dtstart/dtend, ical:location); these terms carry what iCal doesn't.

ik:calendar a rdf:Property ;
    rdfs:range xsd:string ;
    rdfs:label "calendar" ;
    rdfs:comment "The source a calendar event came from — a native calendar's title (\"Bosatsu\") or an org file's short name (\"calendar.org\"). Provenance for consolidated views." .

ik:allDay a rdf:Property ;
    rdfs:range xsd:boolean ;
    rdfs:label "allDay" ;
    rdfs:comment "Whether an event is all-day (date-valued rather than timed)." .

# ---- LLM backends (the urn:llm trait graph) -----------------------------------

ik:LlmBackend a rdfs:Class ;
    rdfs:label "LlmBackend" ;
    rdfs:comment "A configured LLM inference backend (one urn:llm:<provider>:ask), described by its trait profile so selection can be capability-based (\"a vision model with ≥32k context, not from this vendor\") rather than by name." .

ik:model a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:string ;
    rdfs:label "model" ;
    rdfs:comment "The backend's default model id, e.g. \"llama3.2:3b\"." .

ik:context a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:integer ;
    rdfs:label "context" ;
    rdfs:comment "The model's context window, in tokens." .

ik:modality a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:string ;
    rdfs:label "modality" ;
    rdfs:comment "An input modality the model supports: \"text\", \"vision\", \"audio\"." .

ik:tools a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:boolean ;
    rdfs:label "tools" ;
    rdfs:comment "Whether the model supports tool / function calling." .

ik:jsonMode a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:boolean ;
    rdfs:label "jsonMode" ;
    rdfs:comment "Whether the model supports a structured-output (JSON) mode." .

ik:cost a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:string ;
    rdfs:label "cost" ;
    rdfs:comment "The backend's cost tier: \"local\" < \"cheap\" < \"premium\". Selection policy is cheapest-that-fits." .

ik:vendor a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:string ;
    rdfs:label "vendor" ;
    rdfs:comment "The service behind the endpoint (\"ollama\", \"openai\", \"anthropic\", \"mlx\") — the governance axis: a vendor!= requirement excludes it, and an undeclared vendor cannot pass the exclusion." .

ik:params a rdf:Property ;
    rdfs:domain ik:LlmBackend ;
    rdfs:range xsd:string ;
    rdfs:label "params" ;
    rdfs:comment "Display-only parameter count, e.g. \"3B\", \"70B\"." .

ik:routesTo a rdf:Property ;
    rdfs:range rdfs:Resource ;
    rdfs:label "routesTo" ;
    rdfs:comment "Where a facade resolves by default — e.g. urn:llm:ask routesTo the configured default backend." .

ik:alert a rdf:Property ;
    rdfs:range xsd:integer ;
    rdfs:label "alert" ;
    rdfs:comment "An alarm on an event: minutes before the start (multi-valued — an event may alert at 60 and 1440). Sourced from an org :ALERT: property (\"1h 1d\") or a calendar alarm; changes flow through view derivation like any other edit." .
